# Candy deployment environment. Copy to /etc/candy/candy.env, fill in every
# value, and give the file mode 0640 owned by root:candy — it holds two keys.
#
# Every variable above the optional block is required: a Candy process whose
# environment is missing one refuses to start rather than starting
# half-configured. packages/bundle/candy-app/README.md explains each.

# The exact external origin browsers reach this deployment at. Requests naming
# another Host are refused, so this must match what Nginx serves.
CANDY_PUBLIC_ORIGIN=https://candy.example.com

# The SQLite file holding the control plane, and the directory each tenant's
# runtime pool is created under. Both belong to the service user alone.
CANDY_DATABASE_PATH=/var/lib/candy/control-plane.db
CANDY_RUNTIME_POOL_BASE=/var/lib/candy/pools

# Who issues execution assertions, and which runtime admits them. A deployment
# running more than one runtime gives each its own audience.
CANDY_CONTROL_PLANE_ISSUER=candy-control-plane
CANDY_RUNTIME_AUDIENCE=candy-runtime-1

# Exactly 32 characters. Generate with: openssl rand -base64 24
CANDY_CREDENTIAL_KEY=replace-me-with-32-characters-xx
# The keyring version the key above is registered under. Every sealed envelope
# names the version it was sealed with; changing the key changes this too.
CANDY_CREDENTIAL_KEY_VERSION=2026-09-a

# At least 32 characters. Generate with: openssl rand -base64 32
CANDY_ASSERTION_SECRET=replace-me-with-at-least-32-characters

# The identity provider, exactly as it publishes itself.
CANDY_OIDC_ISSUER=https://identity.example.com
CANDY_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.com/authorize
CANDY_OIDC_TOKEN_ENDPOINT=https://identity.example.com/token
CANDY_OIDC_USERINFO_ENDPOINT=https://identity.example.com/userinfo
CANDY_OIDC_CLIENT_ID=candy
# The key set ID Tokens are verified against. Rotating the trust anchor is a
# write to this one file.
CANDY_OIDC_JWKS_PATH=/etc/candy/oidc-jwks.json

# ── optional ────────────────────────────────────────────────────────────────

# The NAME of the variable holding the OIDC client secret, not the secret. A
# public client authenticating with PKCE alone leaves this unset.
#CANDY_OIDC_CLIENT_SECRET_ENV=CANDY_OIDC_CLIENT_SECRET
#CANDY_OIDC_CLIENT_SECRET=

# First install only: the provider subject enrolled as administrator, and the
# Candy user it signs in as. Both or neither. Once an administrator exists and
# has enrolled everyone else, leave both unset.
#CANDY_BOOTSTRAP_ADMIN_SUBJECT=
#CANDY_BOOTSTRAP_ADMIN_USER_ID=
